---
interface Props {
  site: "ferber" | "tgwab" | "dev" | "kj4dia";
  currentPath?: string;
}
const { site, currentPath = "" } = Astro.props;

const localLinks = [
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const globalLinks = [
  { href: "https://michalferber.com/", label: "michalferber.com", key: "ferber", tooltip: "Blog" },
  { href: "https://techguywithabeard.com/", label: "techguywithabeard.com", key: "tgwab", tooltip: "Services" },
  { href: "https://michalferber.dev/", label: "michalferber.dev", key: "dev", tooltip: "Products" },
  { href: "https://kj4dia.me/", label: "KJ4dia.me", key: "kj4dia", tooltip: "Amateur Radio" },
  { href: "https://ferber.me/", label: "Ferber.me", key: "external", tooltip: "Family" },
];

const siteLabel =
  site === "ferber"
    ? "Michal Ferber Blog"
    : site === "tgwab"
      ? "TechGuyWithABeard"
      : site === "dev"
        ? "Michal Ferber Dev"
        : "KJ4DIA";
---

<nav class="tgwab-nav">
  <div class="container tgwab-nav__inner">
    <a href="/" class="tgwab-nav__brand">
      {siteLabel}
    </a>
    <ul class="tgwab-nav__links tgwab-nav__links--local">
      {localLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[{ active: currentPath === link.href }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="container tgwab-nav__domains" aria-label="Domain switcher">
    {globalLinks.map((link) => (
      <a
        href={link.href}
        class:list={["domain-pill", { active: link.key === site }]}
        title={link.tooltip}
        data-tooltip={link.tooltip}
        target={link.key === "external" ? "_blank" : undefined}
        rel={link.key === "external" ? "noopener noreferrer" : undefined}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .tgwab-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .tgwab-nav__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }

  .tgwab-nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--step-1);
  }

  .tgwab-nav__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .tgwab-nav__links a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--step--1);
    padding: 0.3rem 0.72rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
  }

  .tgwab-nav__links a:hover,
  .tgwab-nav__links a.active {
    color: var(--ink);
    border-color: var(--line);
    background: color-mix(in srgb, var(--surface-raised) 86%, transparent);
  }

  .tgwab-nav__domains {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .domain-pill {
    position: relative;
    text-decoration: none;
    font-size: 0.73rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.32rem 0.62rem;
    transition: transform 180ms ease, color 180ms ease;
  }

  .domain-pill.active {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .domain-pill:hover {
    color: var(--ink);
    transform: translateY(-1px);
  }

  .domain-pill::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.35rem);
    transform: translateX(-50%);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    color: var(--ink);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.16rem 0.38rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 130ms ease;
  }

  .domain-pill:hover::after {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .tgwab-nav__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

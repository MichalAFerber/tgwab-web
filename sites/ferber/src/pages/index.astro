---
import Layout from "@tgwab/ui/Layout.astro";
import { getCollection } from "astro:content";
import { parseDateFromSlug } from "../lib/post-date";

const dateValue = (slug: string) => parseDateFromSlug(slug)?.valueOf() ?? 0;

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((left, right) => dateValue(right.id) - dateValue(left.id))
  .map((post) => ({
    title: post.data.title,
    href: `/${post.id}/`,
    dateValue: dateValue(post.id),
    heroImage: post.data.heroImage || post.data["thumbnail-img"] || "/img/post-build.svg",
    excerpt: post.data.description,
    tags: post.data.tags,
  }));
---

<Layout
  site="ferber"
  title="Blog | Michal Ferber"
  description="Notes on building, operating, and shipping projects by Michal Ferber."
  canonical="https://michalferber.me/"
>
  <section class="hero container reveal">
    <p class="eyebrow">MICHALFERBER.ME</p>
    <h1>Blog posts and practical notes from a builder who likes working software.</h1>
    <p class="lede">
      Long-form writing about projects, infrastructure, and decisions behind the work.
      michalferber.me always points directly to the post list.
    </p>
  </section>

  <section class="container reveal" data-delay="1">
    <div class="posts-head">
      <h2 class="section-title">Posts</h2>
      <a class="feed-link" href="/rss.xml">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="5.5" cy="18.5" r="2" />
          <path d="M4 11a9 9 0 0 1 9 9h-2.5A6.5 6.5 0 0 0 4 13.5z" />
          <path d="M4 4a16 16 0 0 1 16 16h-2.5A13.5 13.5 0 0 0 4 6.5z" />
        </svg>
        RSS feed
      </a>
    </div>
    <div class="grid">
      {posts.map((post) => (
        <article class="surface-card card">
          <a class="thumb-link" href={post.href} aria-label={`Read ${post.title}`}>
            <img class="thumb" src={post.heroImage} alt="" loading="lazy" />
          </a>
          <p class="meta">
            {new Date(post.dateValue).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
          </p>
          <h3><a href={post.href}>{post.title}</a></h3>
          <p>{post.excerpt}</p>
          <div class="tag-list" aria-label={`Tags for ${post.title}`}>
            {post.tags.map((tag) => (
              <a href={`/tags/#${tag.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`}>{tag}</a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-16) 0 var(--space-12);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-faint);
    font-size: 0.72rem;
    margin-bottom: var(--space-3);
  }

  .hero h1 {
    max-width: 18ch;
    margin-bottom: var(--space-4);
  }

  .lede {
    max-width: 62ch;
  }

  /* The heading's rule runs out to the feed link instead of the edge. */
  .posts-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .posts-head .section-title {
    flex: 1;
    margin-bottom: 0;
  }

  .feed-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    padding: var(--space-1) var(--space-3);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-raised) 82%, transparent);
  }

  .feed-link:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  .feed-link svg {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
  }

  /* Mobile-first (DEV-STANDARDS §3): 1 col base, 2 cols from the tablet tier. */
  .grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  .card {
    padding: var(--space-6);
  }

  .thumb-link {
    display: block;
    margin: calc(-1 * var(--space-6));
    margin-bottom: var(--space-4);
  }

  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    border-bottom: 1px solid var(--line);
  }

  .meta {
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: var(--space-3);
  }

  .card h3 {
    margin-bottom: var(--space-3);
  }

  .card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .card h3 a:hover {
    color: var(--accent);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .tag-list a {
    text-decoration: none;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.28rem 0.62rem;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--surface-raised) 82%, transparent);
  }

  .tag-list a:hover {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  @media (min-width: 680px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

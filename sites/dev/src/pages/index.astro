    status: "Live",
    external: "https://textwizard.us",
    github: "https://github.com/MichalAFerber/textwizard",
    series: "Wizard",
  },
  {
    name: "UploadWizard.app",
    description: "Simple, direct file uploads with a clean workflow for sharing content quickly.",
    status: "Live",
    external: "https://uploadwizard.app",
    github: "https://github.com/MichalAFerber/uploadwizard",
    series: "Wizard",
  },
];

const scriptCards = [
  {
    name: "Default Web Pages",
    description: "Recreation archive of web-server default pages — Microsoft IIS (1995–2022) and the major Linux servers (nginx, Apache, Caddy).",
    status: "Reference",
    external: "https://michalaferber.github.io/default-web-pages/",
    github: "https://github.com/MichalAFerber/default-web-pages",
  },
  {
    name: "email-to-discord_cf-worker",
    description: "Cloudflare Worker that routes inbound emails to a Discord channel via webhook — turn a custom-domain inbox into a Discord notification stream.",
    status: "Active",
    external: "https://michalaferber.github.io/email-to-discord_cf-worker/",
    github: "https://github.com/MichalAFerber/email-to-discord_cf-worker",
  },
  {
    name: "Frequency Tone Generator",
    description: "Minimal client-side tone generator — produce precise frequencies in the browser. Single-page tool, zero dependencies.",
    status: "Reference",
    external: "https://michalaferber.github.io/frequency-tone-generator/",
    github: "https://github.com/MichalAFerber/frequency-tone-generator",
  },
  {
    name: "GitHub Tree Browser",
    description: "Browse any public GitHub repo's file tree without cloning. Single-page web tool — paste a URL, get the tree.",
    status: "Reference",
    external: "https://michalaferber.github.io/github-tree-browser/",
    github: "https://github.com/MichalAFerber/github-tree-browser",
  },
  {
    name: "IMDbMovieFileFixer",
    description: "Auto-rename movies, fix grammar, check IMDb, handle duplicates. Your collection, perfected.",
    status: "Active",
    external: "https://michalaferber.github.io/IMDbMovieFileFixer/",
    github: "https://github.com/MichalAFerber/IMDbMovieFileFixer",
  },
  {
    name: "Modding-in-FS25",
    description: "Michal's InGame Mods for Farming Simulator 25 — a single-file Lua script mod that removes speed caps, maxes trailer capacity, and equalizes tractor power, with transparent logging.",
    status: "Active",
    external: "https://michalaferber.github.io/Modding-in-FS25/",
    github: "https://github.com/MichalAFerber/Modding-in-FS25",
  },
  {
    name: "pi-hole",
    description: "Personal Pi-hole customizations and curated blocklists for ad-free, ad-block-aware home DNS filtering.",
    status: "Active",
    external: "#",
    github: "https://github.com/MichalAFerber/pi-hole",
  },
  {
    name: "Scripts Collection",
    description: "A curated collection of homelab, backup, sync, media, and system automation scripts — Bash, Python, PowerShell, organized by topic. Every file-modifying script supports --dry-run.",
    status: "Active",
    external: "https://michalaferber.github.io/scripts/",
    github: "https://github.com/MichalAFerber/scripts",
  },
  {
    name: "unbound-homelab",
    description: "Production-ready redundant Unbound DNS infrastructure for home labs. Pi-based primary/secondary resolvers with DNSSEC, automated config sync, health monitoring, and TSV-based host management.",
    status: "Reference",
    external: "https://michalaferber.github.io/unbound-homelab/",
    github: "https://github.com/MichalAFerber/unbound-homelab",
  },
  {
    name: "Welcome-Message",
    description: "Beautiful terminal welcome message with fastfetch, weather, system metrics & multi-language support. Configurable, cached, supports 5+ distros. Bash & ZSH compatible.",
    status: "Active",
    external: "https://michalaferber.github.io/welcome-message/",
    github: "https://github.com/MichalAFerber/welcome-message",
  },
];

const macAppCards = [
  {
    name: "Tomatick",
    description: "macOS menu-bar timer, stopwatch, alarm & pomodoro with timestamped history. Built with rumps + PyObjC.",
    status: "Live",
    external: "https://tomatick.us",
    github: "https://github.com/MichalAFerber/tomatick",
  },
];

const productCards = [
  {
    name: "BCMSImport",
    description: "Imported BCMS (Brilliance Call Management System) call-center reports into a SQL Server database for downstream reporting. .NET Windows Forms, early 2010s.",
    status: "Retired",
    external: "#",
    github: "https://github.com/MichalAFerber/BCMSImport",
  },
  {
    name: "Braintree Prototype",
    description: "Small .NET prototype exploring Braintree (PayPal-owned) payment processing for a desktop app. Sandbox-only feasibility study from 2021.",
    status: "Retired",
    external: "#",
    github: "https://github.com/MichalAFerber/braintree-by-paypal",
  },
  {
    name: "GSA Manager",
    description: "GSA Manager is a cloud-based SaaS application hosted on the Microsoft Azure platform. Actively developed since 2007 and still trusted by its very first customer, it brings together point of sale, inventory, CRM, task management, and payment processing into one streamlined solution.",
    status: "Retired",
    external: "https://gsamanager.org",
    github: "https://github.com/MichalAFerber/gsamanager.org",
  },
  {
    name: "ModMan",
    description: "Mod Manager for Farming Simulator 2019. FS19 game XML file and mod manager. Easy to use, simple interface, and only one file. User guide preserved.",
    status: "Retired",
    external: "https://michalaferber.github.io/ModMan/",
    github: "https://github.com/MichalAFerber/ModMan",
  },
  {
    name: "SilentApp",
    description: "Silent login-time utility that cleaned up unwanted desktop icons re-pushed by group policy. Background-only, no visible UI.",
    status: "Retired",
    external: "#",
    github: "https://github.com/MichalAFerber/silentapp",
  },
  {
    name: "SwitchboardMaintenance",
    description: "Switchboard / PBX maintenance utility used by a former employer's telephony team. Binary-only — the original .NET source was lost; the .exe is preserved as a historical artifact.",
    status: "Retired",
    external: "#",
    github: "https://github.com/MichalAFerber/switchboard-maintenance",
  },
  {
    name: "TelecomManager",
    description: "Telecom work-order tracking app for a former employer (2007-2018). .NET Windows Forms + SQL Server + Crystal Reports. 22+ version snapshots preserved in the archive.",
    status: "Retired",
    external: "#",
    github: "https://github.com/MichalAFerber/telecom-manager",
  },
  {
    name: "VCV",
    description: "Video Camera Viewer — multi-camera grid viewer for IP cameras. .NET Windows Forms app with Azure SQL backend for camera list persistence.",
    status: "Retired",
    external: "#",
    github: "https://github.com/MichalAFerber/vcv",
  },
];

// Keep every section alphabetized, including future additions.
const byName = (a, b) => a.name.localeCompare(b.name);
[extensionCards, websiteCards, scriptCards, macAppCards, productCards].forEach((cards) =>
  cards.sort(byName),
);

const hasLink = (url) => Boolean(url && url !== "#");
---

<Layout
  site="dev"
  title="Products | Michal Ferber"
  description="Products, extensions, scripts, and websites by Michal Ferber."
  canonical="https://michalferber.dev/"
>
  <section class="container hero reveal">
    <p class="eyebrow">MICHALFERBER.DEV</p>
    <h1>Products, experiments, and useful tools.</h1>
    <p class="lede">
      One page to navigate active products, in-progress ideas, scripts, and companion websites.
    </p>
  </section>

  <section class="container reveal" data-delay="1">
    <h2 class="section-title">Chrome Extensions</h2>
    <div class="grid">
      {extensionCards.map((card) => (
        <article class="surface-card card">
          <div class="card-head">
            <h3>{card.name}</h3>
            <span class="status">{card.status}</span>
          </div>
          <p class="card-description">{card.description}</p>
          <div class="card-footer">
            <div class="links">
              <a href={card.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub for ${card.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.66-.22.66-.48v-1.87c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.51-1.11-1.51-.9-.63.07-.62.07-.62 1 .08 1.52 1.05 1.52 1.05.88 1.57 2.31 1.12 2.87.86.09-.66.35-1.12.64-1.38-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.04A9.27 9.27 0 0 1 12 7.25c.85 0 1.7.12 2.5.36 1.91-1.32 2.74-1.04 2.74-1.04.56 1.42.21 2.46.11 2.72.64.71 1.03 1.62 1.03 2.74 0 3.95-2.33 4.82-4.56 5.08.36.32.68.94.68 1.9v2.81c0 .27.17.59.67.48A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2z"/></svg>
                GitHub
              </a>
              {hasLink(card.external) && (
                <a href={card.external} target="_blank" rel="noopener noreferrer" aria-label={`External site for ${card.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3z"/><path d="M19 19H5V5h6V3H5c-1.1 0-2 .9-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-6h-2v6z"/></svg>
                  Visit
                </a>
              )}
              <a href={card.chrome} aria-label={`Chrome Web Store for ${card.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 1 8.66 5H12a5 5 0 0 0-4.33 2.5L5.5 5.75A10 10 0 0 1 12 2z"/><path d="M3.34 7A10 10 0 0 0 12 22l4.33-7.5A5 5 0 0 1 12 17a5 5 0 0 1-4.33-2.5L3.34 7z"/><path d="M20.66 7h-8.66a5 5 0 0 1 4.33 7.5H21A10 10 0 0 0 20.66 7z"/></svg>
                Chrome
              </a>
            </div>
            {card.series && <p class="series-tag">Part of {card.series} Series</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container reveal" data-delay="2">
    <h2 class="section-title">Websites</h2>
    <div class="grid compact">
      {websiteCards.map((card) => (
        <article class="surface-card card compact-card">
          <div class="card-head">
            <h3>{card.name}</h3>
            {card.status && <span class="status">{card.status}</span>}
          </div>
          <p class="card-description">{card.description}</p>
          <div class="card-footer">
            <div class="links">
              <a href={card.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub for ${card.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.66-.22.66-.48v-1.87c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.51-1.11-1.51-.9-.63.07-.62.07-.62 1 .08 1.52 1.05 1.52 1.05.88 1.57 2.31 1.12 2.87.86.09-.66.35-1.12.64-1.38-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.04A9.27 9.27 0 0 1 12 7.25c.85 0 1.7.12 2.5.36 1.91-1.32 2.74-1.04 2.74-1.04.56 1.42.21 2.46.11 2.72.64.71 1.03 1.62 1.03 2.74 0 3.95-2.33 4.82-4.56 5.08.36.32.68.94.68 1.9v2.81c0 .27.17.59.67.48A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2z"/></svg>
                GitHub
              </a>
              {hasLink(card.external) && (
                <a href={card.external} target="_blank" rel="noopener noreferrer" aria-label={`External site for ${card.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3z"/><path d="M19 19H5V5h6V3H5c-1.1 0-2 .9-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-6h-2v6z"/></svg>
                  Visit
                </a>
              )}
            </div>
            {card.series && <p class="series-tag">Part of {card.series} Series</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container reveal" data-delay="3">
    <h2 class="section-title">Scripts</h2>
    <div class="grid compact">
      {scriptCards.map((card) => (
        <article class="surface-card card compact-card">
          <div class="card-head">
            <h3>{card.name}</h3>
            {card.status && <span class="status">{card.status}</span>}
          </div>
          <p class="card-description">{card.description}</p>
          <div class="card-footer">
            <div class="links">
              <a href={card.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub for ${card.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.66-.22.66-.48v-1.87c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.51-1.11-1.51-.9-.63.07-.62.07-.62 1 .08 1.52 1.05 1.52 1.05.88 1.57 2.31 1.12 2.87.86.09-.66.35-1.12.64-1.38-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.04A9.27 9.27 0 0 1 12 7.25c.85 0 1.7.12 2.5.36 1.91-1.32 2.74-1.04 2.74-1.04.56 1.42.21 2.46.11 2.72.64.71 1.03 1.62 1.03 2.74 0 3.95-2.33 4.82-4.56 5.08.36.32.68.94.68 1.9v2.81c0 .27.17.59.67.48A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2z"/></svg>
                GitHub
              </a>
              {hasLink(card.external) && (
                <a href={card.external} target="_blank" rel="noopener noreferrer" aria-label={`External site for ${card.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3z"/><path d="M19 19H5V5h6V3H5c-1.1 0-2 .9-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-6h-2v6z"/></svg>
                  Open
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container reveal" data-delay="3">
    <h2 class="section-title">macOS Apps</h2>
    <div class="grid">
      {macAppCards.map((card) => (
        <article class="surface-card card">
          <div class="card-head">
            <h3>{card.name}</h3>
            {card.status && <span class="status">{card.status}</span>}
          </div>
          <p class="card-description">{card.description}</p>
          <div class="card-footer">
            <div class="links">
              <a href={card.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub for ${card.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.66-.22.66-.48v-1.87c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.51-1.11-1.51-.9-.63.07-.62.07-.62 1 .08 1.52 1.05 1.52 1.05.88 1.57 2.31 1.12 2.87.86.09-.66.35-1.12.64-1.38-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.04A9.27 9.27 0 0 1 12 7.25c.85 0 1.7.12 2.5.36 1.91-1.32 2.74-1.04 2.74-1.04.56 1.42.21 2.46.11 2.72.64.71 1.03 1.62 1.03 2.74 0 3.95-2.33 4.82-4.56 5.08.36.32.68.94.68 1.9v2.81c0 .27.17.59.67.48A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2z"/></svg>
                GitHub
              </a>
              {hasLink(card.external) && (
                <a href={card.external} target="_blank" rel="noopener noreferrer" aria-label={`External site for ${card.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3z"/><path d="M19 19H5V5h6V3H5c-1.1 0-2 .9-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-6h-2v6z"/></svg>
                  Visit
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container reveal" data-delay="3">
    <h2 class="section-title">Windows Apps</h2>
    <div class="grid">
      {productCards.map((card) => (
        <article class="surface-card card">
          <div class="card-head">
            <h3>{card.name}</h3>
            {card.status && <span class="status">{card.status}</span>}

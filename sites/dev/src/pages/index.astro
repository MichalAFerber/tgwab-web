    name: "PPTX Viewer",
    description: "View PowerPoint presentations slide by slide — text, layout, and images.",
    status: "Live",
    external: "https://pptx-viewer.us",
    github: "https://github.com/MichalAFerber/pptx-web-viewer",
    series: "File Viewer",
  },
  {
    name: "PUB Viewer",
    description: "Read Microsoft Publisher files with metadata and text extraction.",
    status: "Live",

  },
  {
    name: "Cheatsheets",
    description: "Clean, printable developer cheatsheets — Shell & CLI, editors, DevOps, languages, and macOS. 19 sheets with PDF downloads, privacy-first with no trackers.",
    status: "Live",
    external: "https://michalaferber.github.io/cheatsheets/",
    github: "https://github.com/MichalAFerber/cheatsheets",
  },
  {
    name: "Data Viewer",
    description: "Explore JSON, YAML, CSV, TSV, and XML as collapsible trees or tables.",
    status: "Live",
    external: "https://data-viewer.us",
    github: "https://github.com/MichalAFerber/data-web-viewer",
    series: "File Viewer",
  },
  {
    name: "DOCX Viewer",
    description: "View Word documents with formatting, tables, and images preserved.",
    status: "Live",
    external: "https://docx-viewer.us",
    github: "https://github.com/MichalAFerber/docx-web-viewer",
    series: "File Viewer",
  },
  {

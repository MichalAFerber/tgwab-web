---
interface Props {
  site: "ferber" | "tgwab" | "dev" | "kj4dia" | "ferberme";
  currentPath?: string;
}
const { site, currentPath = "" } = Astro.props;

const localLinks = [
  { href: "/about/", label: "About", kind: "about" },
  { href: "/contact/", label: "Contact", kind: "contact" },
  { href: "/search/", label: "Search", kind: "search" },
];

const globalLinks = [
  { href: "https://michalferber.me/", label: "michalferber.me", key: "ferber", tooltip: "Blog" },
  { href: "https://techguywithabeard.com/", label: "techguywithabeard.com", key: "tgwab", tooltip: "Services" },
  { href: "https://michalferber.dev/", label: "michalferber.dev", key: "dev", tooltip: "Products" },
  { href: "https://kj4dia.me/", label: "KJ4dia.me", key: "kj4dia", tooltip: "Amateur Radio" },
  { href: "https://ferber.me/", label: "Ferber.me", key: "ferberme", tooltip: "Family" },
];

const siteLabel =
  site === "ferber"
    ? "Michal Ferber Blog"
    : site === "tgwab"
      ? "TechGuyWithABeard"
      : site === "dev"
        ? "Michal Ferber Dev"
        : site === "kj4dia"
          ? "KJ4DIA"
          : "Ferber Family";
---

<nav class="tgwab-nav">
  <div class="container tgwab-nav__inner">
    <a href="/" class="tgwab-nav__brand">
      {siteLabel}
    </a>
    <ul class="tgwab-nav__links tgwab-nav__links--local">
      {localLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={["local-pill", { active: currentPath === link.href }]}
          >
            {link.kind === "about" && (
              <svg class="local-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2zm0 4a1.6 1.6 0 1 1-1.6 1.6A1.6 1.6 0 0 1 12 6zm2 12h-4v-1.5h1V11h-1V9.5h3V16h1z" />
              </svg>
            )}
            {link.kind === "contact" && (
              <svg class="local-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-.4 2L12 11.4 4.4 6h15.2zM4 18V8.2l7.42 5.26a1 1 0 0 0 1.16 0L20 8.2V18H4z" />
              </svg>
            )}
            {link.kind === "search" && (
              <svg class="local-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10 2a8 8 0 1 0 4.9 14.3l4.4 4.4 1.4-1.4-4.4-4.4A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z" />
              </svg>
            )}
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="https://github.com/MichalAFerber/tgwab-web"
          class="local-pill"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Source on GitHub"
        >
          <svg class="local-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.66-.22.66-.48v-1.87c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.51-1.11-1.51-.9-.63.07-.62.07-.62 1 .08 1.52 1.05 1.52 1.05.88 1.57 2.31 1.12 2.87.86.09-.66.35-1.12.64-1.38-2.22-.26-4.55-1.14-4.55-5.08 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.04A9.27 9.27 0 0 1 12 7.25c.85 0 1.7.12 2.5.36 1.91-1.32 2.74-1.04 2.74-1.04.56 1.42.21 2.46.11 2.72.64.71 1.03 1.62 1.03 2.74 0 3.95-2.33 4.82-4.56 5.08.36.32.68.94.68 1.9v2.81c0 .27.17.59.67.48A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2z" />
          </svg>
          GitHub
        </a>
      </li>
    </ul>
    <button
      type="button"
      class="tgwab-theme-toggle"
      data-theme-toggle
      aria-label="Toggle dark or light theme"
      title="Toggle theme"
    >
      <svg class="tgwab-theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7"/></g></svg>
      <svg class="tgwab-theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 14.2A8.5 8.5 0 0 1 9.8 3.6a8.5 8.5 0 1 0 10.6 10.6Z" fill="currentColor"/></svg>
    </button>
  </div>
  <div class="container tgwab-nav__domains" aria-label="Domain switcher">
    {globalLinks.map((link) => (
      <a
        href={link.href}
        class:list={["domain-pill", { active: link.key === site }]}
        title={link.tooltip}
        data-tooltip={link.tooltip}
        target={link.key === "external" ? "_blank" : undefined}
        rel={link.key === "external" ? "noopener noreferrer" : undefined}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .tgwab-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }

  /* Mobile-first (DEV-STANDARDS §3): base = stacked; ≥980px = one row. */
  .tgwab-nav__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    min-height: 3.2rem;
  }

  @media (min-width: 980px) {
    .tgwab-nav__inner {
      flex-direction: row;
      align-items: center;
    }
    /* Pills + theme toggle sit as one right-aligned group; the brand keeps
       the left edge (owner call 2026-07-30). */
    .tgwab-nav__links--local {
      margin-inline-start: auto;
    }
  }

  .tgwab-nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--step-1);
    white-space: nowrap;
    line-height: 1;
  }

  .tgwab-nav__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .tgwab-nav__links--local {
    flex-wrap: nowrap;
  }

  .tgwab-nav__links a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--step--1);
    padding: 0.32rem 0.72rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-raised) 86%, transparent);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .tgwab-nav__links a:hover,
  .tgwab-nav__links a.active {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    background: color-mix(in srgb, var(--surface-raised) 96%, transparent);
  }

  .local-icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    flex-shrink: 0;
  }

  .tgwab-nav__domains {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .domain-pill {
    position: relative;
    text-decoration: none;
    font-size: 0.73rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.32rem 0.62rem;
    transition: transform 180ms ease, color 180ms ease;
  }

  .domain-pill.active {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .domain-pill:hover {
    color: var(--ink);
    transform: translateY(-1px);
  }

  .domain-pill::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.35rem);
    transform: translateX(-50%);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    color: var(--ink);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.16rem 0.38rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 130ms ease;
  }

  .domain-pill:hover::after {
    opacity: 1;
  }

  /* Touch targets ≥40px (DEV-STANDARDS §3/§14). */
  @media (pointer: coarse) {
    .tgwab-nav__links a,
    .domain-pill {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.querySelector("[data-theme-toggle]");
    if (!btn) return;
    const root = document.documentElement;
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
    const current = () => root.dataset.theme || (systemDark.matches ? "dark" : "light");
    btn.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("tgwab-theme", next); } catch {}
    });
  })();
</script>

<style>
  .tgwab-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-inline-start: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .tgwab-theme-toggle:hover { color: var(--accent); }
  .tgwab-theme-toggle svg { width: 1.1rem; height: 1.1rem; }
  .tgwab-theme-toggle__sun { display: none; }
  .tgwab-theme-toggle__moon { display: block; }
  @media (prefers-color-scheme: light) {
    html:not([data-theme="dark"]) .tgwab-theme-toggle__sun { display: block; }
    html:not([data-theme="dark"]) .tgwab-theme-toggle__moon { display: none; }
  }
  html[data-theme="light"] .tgwab-theme-toggle__sun { display: block; }
  html[data-theme="light"] .tgwab-theme-toggle__moon { display: none; }
  html[data-theme="dark"] .tgwab-theme-toggle__sun { display: none !important; }
  html[data-theme="dark"] .tgwab-theme-toggle__moon { display: block !important; }
</style>

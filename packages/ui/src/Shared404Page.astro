---
import Layout from "./Layout.astro";

interface Props {
  site: "ferber" | "tgwab" | "dev" | "kj4dia" | "ferberme";
}

const { site } = Astro.props;

const homeBySite = {
  ferber: "the blog",
  tgwab: "the homepage",
  dev: "the products",
  kj4dia: "the homepage",
  ferberme: "the family home",
};
---

{/*
  noCanonical: this page is served under *every* unknown URL, so a canonical
  (which would always point at /404/) makes Google file those URLs as "Alternate
  page with proper canonical tag" instead of "Not found (404)". A 404 response
  must carry no canonical — the status is the signal.
*/}
<Layout
  site={site}
  title="404 — Page not found"
  description="This page can't be found."
  noindex
  noCanonical
>
  <section class="container reveal page-404">
    <p class="eyebrow">404</p>
    <h1>This page can't be found.</h1>
    <p class="lede">A broken link, a typo, or a page that has since moved.</p>
    <p><a href="/">&larr; Back to {homeBySite[site]}</a></p>
  </section>
</Layout>

<script is:inline>
  window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments) };
  plausible('404', { props: { path: document.location.pathname } });
</script>

<style>
  .page-404 {
    padding: var(--space-16) 0;
  }
</style>

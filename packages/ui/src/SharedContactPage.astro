---
import Layout from "./Layout.astro";

interface Props {
  site: "ferber" | "tgwab" | "dev" | "kj4dia" | "ferberme";
}

const { site } = Astro.props;

const domainBySite = {
  ferber: "https://michalferber.me",
  tgwab: "https://techguywithabeard.com",
  dev: "https://michalferber.dev",
  kj4dia: "https://kj4dia.me",
  ferberme: "https://ferber.me",
};

const titleBySite = {
  ferber: "Contact | Michal Ferber",
  tgwab: "Contact | TechGuyWithABeard",
  dev: "Contact | MichalFerber.dev",
  kj4dia: "Contact | KJ4dia.me",
  ferberme: "Contact | Ferber.me",
};
---

<Layout
  site={site}
  title={titleBySite[site]}
  description="Contact form for questions, project inquiries, product support, and collaboration."
  canonical={`${domainBySite[site]}/contact/`}
>
  <section class="container contact reveal">
    <h1>Contact</h1>
    <p>Share what you need, your timeline, and what a successful outcome looks like.</p>

    <form class="surface-card form" method="post" name="project-intake" data-contact-form>
      <label>
        Name
        <input name="name" type="text" required maxlength="100" />
      </label>
      <label>
        Email
        <input name="email" type="email" required maxlength="254" />
      </label>
      <label>
        Subject
        <input name="subject" type="text" required maxlength="150" />
      </label>
      <label>
        How can I help?
        <textarea name="details" rows="6" required maxlength="5000"></textarea>
      </label>
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAD5MeaGLtwlOoiYM"></div>
      <button type="submit">Send inquiry</button>
      <p class="form-status" data-status role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>

<script>
  // Submits to the shared mailer worker (herald platform). Server side does the
  // real gates — Turnstile siteverify, Origin allowlist, validation — this is
  // just transport + feedback.
  const form = document.querySelector("[data-contact-form]") as HTMLFormElement;
  const status = document.querySelector("[data-status]") as HTMLElement;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector("button") as HTMLButtonElement;
    const data = new FormData(form);
    const turnstileToken = data.get("cf-turnstile-response");
    if (!turnstileToken) {
      status.textContent = "Please complete the verification and try again.";
      return;
    }
    button.disabled = true;
    status.textContent = "Sending…";
    try {
      const res = await fetch("https://mailer.thompsonblack.us/contact/tgwab", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: data.get("name"),
          email: data.get("email"),
          subject: data.get("subject"),
          message: data.get("details"),
          turnstileToken,
        }),
      });
      if (res.ok) {
        form.reset();
        // @ts-expect-error Turnstile global is injected by its script tag.
        window.turnstile?.reset();
        status.textContent = "Sent — I read every message and reply by email.";
      } else {
        const body = await res.json().catch(() => ({ error: "request failed" }));
        status.textContent = `Could not send (${body.error ?? res.status}). Email michal@techguywithabeard.com instead.`;
        button.disabled = false;
      }
    } catch {
      status.textContent = "Network error — email michal@techguywithabeard.com instead.";
      button.disabled = false;
    }
  });
</script>

<style>
  .contact {
    padding: var(--space-16) 0;
    display: grid;
    gap: var(--space-8);
  }

  .form {
    padding: var(--space-8);
    display: grid;
    gap: var(--space-6);
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  input,
  select,
  textarea {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--surface-raised) 85%, black);
    color: var(--ink);
    font: inherit;
    padding: 0.62rem 0.74rem;
  }

  button {
    width: fit-content;
    border: 0;
    border-radius: var(--radius-pill);
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    color: var(--bg);
    font: inherit;
    font-weight: 700;
    padding: 0.66rem 1.1rem;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .form-status {
    margin: 0;
    min-height: 1.4em;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
</style>

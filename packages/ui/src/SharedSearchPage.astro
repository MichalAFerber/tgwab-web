---
import Layout from "./Layout.astro";

interface Props {
  site: "ferber" | "tgwab" | "dev" | "kj4dia" | "ferberme";
}

const { site } = Astro.props;

const domainBySite = {
  ferber: "https://michalferber.me",
  tgwab: "https://techguywithabeard.com",
  dev: "https://michalferber.dev",
  kj4dia: "https://kj4dia.me",
  ferberme: "https://ferber.me",
};

const titleBySite = {
  ferber: "Search | Michal Ferber",
  tgwab: "Search | TechGuyWithABeard",
  dev: "Search | MichalFerber.dev",
  kj4dia: "Search | KJ4DIA",
  ferberme: "Search | Ferber.me",
};

// The page loads its own /pagefind/ index relatively, then merges the other four
// domains so one query spans all five sites. Their /pagefind/* is served with CORS
// (see each site's public/_headers); baseUrl makes cross-domain result URLs
// absolute to the right domain.
const mergeTargets = Object.entries(domainBySite)
  .filter(([key]) => key !== site)
  .map(([, url]) => ({ bundlePath: `${url}/pagefind/`, baseUrl: url }));
---

<Layout
  site={site}
  title={titleBySite[site]}
  description="Full-text search across all five Michal Ferber websites."
  canonical={`${domainBySite[site]}/search/`}
  noindex
>
  <section class="container page reveal">
    <p class="eyebrow">SEARCH</p>
    <h1>Search Across All Five Sites</h1>
    <p class="lede">Full-text search across michalferber.me, techguywithabeard.com, michalferber.dev, kj4dia.me, and ferber.me.</p>

    <label class="search-label" for="site-search-input">Query</label>
    <input id="site-search-input" class="search-input" type="search" placeholder="Try: dns, podman, ham radio, family" autocomplete="off" />

    <p id="search-status" class="status" hidden></p>
    <ul id="search-results" class="results" aria-live="polite"></ul>
  </section>

  <script define:vars={{ mergeTargets }}>
    const input = document.getElementById("site-search-input");
    const results = document.getElementById("search-results");
    const status = document.getElementById("search-status");

    const setStatus = (msg) => {
      status.textContent = msg || "";
      status.hidden = !msg;
    };

    let pagefindPromise;
    const getPagefind = () => {
      if (!pagefindPromise) {
        pagefindPromise = (async () => {
          const pf = await import("/pagefind/pagefind.js");
          for (const target of mergeTargets) {
            try {
              // Probe before merging: pagefind keeps a FAILED merge registered
              // internally, after which every search() rejects — one unreachable
              // sibling would take the whole search page down. Only reachable
              // indexes get merged; the catch keeps the rest on any race.
              const probe = await fetch(`${target.bundlePath}pagefind-entry.json`, {
                signal: AbortSignal.timeout(4000),
              });
              if (!probe.ok) continue;
              await pf.mergeIndex(target.bundlePath, { baseUrl: target.baseUrl });
            } catch (err) {
              // A sibling site's index may be temporarily unavailable; keep the rest.
            }
          }
          return pf;
        })();
      }
      return pagefindPromise;
    };

    const render = (items) => {
      results.innerHTML = "";
      for (const data of items) {
        const li = document.createElement("li");
        li.className = "result-card surface-card";

        const link = document.createElement("a");
        link.href = data.url;
        link.className = "result-link";
        link.textContent = (data.meta && data.meta.title) || data.url;

        const url = document.createElement("p");
        url.className = "result-url";
        url.textContent = data.url;

        const excerpt = document.createElement("p");
        excerpt.className = "result-excerpt";
        excerpt.innerHTML = data.excerpt || "";

        li.append(link, url, excerpt);
        results.appendChild(li);
      }
    };

    let token = 0;
    const run = async (query) => {
      const q = query.trim();
      const mine = ++token;
      if (q.length < 2) {
        render([]);
        setStatus("");
        return;
      }
      setStatus("Searching…");
      try {
        const pf = await getPagefind();
        const search = await pf.search(q);
        if (mine !== token) return;
        const items = await Promise.all(search.results.slice(0, 25).map((r) => r.data()));
        if (mine !== token) return;
        render(items);
        setStatus(items.length ? "" : "No matches found. Try a different keyword.");
      } catch (err) {
        setStatus("Search is unavailable right now.");
      }
    };

    let timer;
    input.addEventListener("input", (event) => {
      clearTimeout(timer);
      const value = event.target.value;
      timer = setTimeout(() => run(value), 200);
    });
  </script>
</Layout>

<style>
  .page {
    padding: var(--space-16) 0;
    display: grid;
    gap: var(--space-6);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    font-size: 0.72rem;
  }

  .lede {
    max-width: 72ch;
  }

  .search-label {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .search-input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface-raised) 86%, black);
    color: var(--ink);
    font: inherit;
    padding: 0.75rem 0.85rem;
  }

  .status {
    color: var(--ink-faint);
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  /* Result cards are created at runtime, so style them globally (scoped under .page). */
  .page :global(.result-card) {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .page :global(.result-link) {
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
  }

  .page :global(.result-link:hover) {
    color: var(--accent);
  }

  .page :global(.result-url) {
    color: var(--ink-faint);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  .page :global(.result-excerpt) {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .page :global(.result-excerpt mark) {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--ink);
    border-radius: 3px;
    padding: 0 0.15em;
  }
</style>

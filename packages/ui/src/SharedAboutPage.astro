    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    transition: transform 180ms ease, color 180ms ease, background 180ms ease;
  }

  .section-nav a:hover,
  .section-nav a:focus-visible {
    color: var(--ink);
    background: color-mix(in srgb, var(--surface-raised) 96%, transparent);
    transform: translateY(-1px);
  }

  /* Mobile-first (DEV-STANDARDS §3): base = compact spacing; ≥980px roomier. */
  .content-block {
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--space-24) + var(--space-8));
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .section-nav + .content-block {
    margin-top: 0;
    border-top: 0;
  }

  .content-block > h2,
  .content-block > h3 {
    margin: 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--space-12);
    row-gap: var(--space-6);
  }

  .skills-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .skill-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--step--1);
  }

  .bar {
    width: 100%;
    height: 0.35rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-raised) 80%, black);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #2f9bff 0%, #50d86a 100%);
  }

  .carousel-track {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .media-carousel {
    position: relative;
    width: min(100%, 820px);
    margin-inline: auto;
  }

  .carousel-item {
    margin: 0;
  }

  .media-link {
    display: block;
    text-decoration: none;
    width: 100%;
    max-width: 700px;
    margin-inline: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2);
    background: color-mix(in srgb, var(--surface-raised) 90%, transparent);
    transition: transform 180ms ease, border-color 180ms ease;
    cursor: zoom-in;
    text-align: left;
  }

  .media-link:hover,
  .media-link:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }

  .media-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .badge-image {
    aspect-ratio: 1 / 1;
    max-height: 420px;
  }

  .cert-image {
    aspect-ratio: 16 / 10;
    max-height: 420px;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface-raised) 88%, transparent);
    color: var(--ink);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .carousel-arrow[data-prev] {
    left: 0.25rem;
  }

  .carousel-arrow[data-next] {
    right: 0.25rem;
  }

  .carousel-arrow:hover,
  .carousel-arrow:focus-visible {
    transform: translateY(-50%) scale(1.06);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    background: color-mix(in srgb, var(--surface-raised) 98%, transparent);

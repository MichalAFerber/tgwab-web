---

<Layout
  site={site}
  title={titleBySite[site]}
  description="About Michal Ferber: 30+ years in IT across development, infrastructure, automation, and consulting."
  canonical={`${domainBySite[site]}/about/`}
>
  <section class="container page reveal">
    <header class="about-hero">
      <h1>About Michal Ferber</h1>
      <p class="hero-subtitle">
        31+ years as a developer, network engineer, sysadmin, and consultant.
      </p>
    </header>

    <div class="section-nav" aria-label="About sections">
      <a href="#bio">Bio</a>
      <a href="#skills">Skills</a>
      <a href="#badges">Badges</a>
      <a href="#certifications">Certifications</a>
      <a href="#transcripts">Transcripts</a>
      <a href="#timeline">Timeline</a>
    </div>

    <section id="bio" class="content-block">
      <h2>Bio</h2>
      <p>
        Hi, I am Michal Ferber. As a hands-on technical leader and founder, I have deep experience
        in software engineering, telecommunications, systems design, and digital operations.
        Throughout my career I have helped teams modernize infrastructure, automate workflows,
        and deliver measurable business outcomes.
      </p>
      <p>
        Over the past 30+ years, I have led efforts in cloud migration, communications,
        API integration, and customer-facing service delivery across healthcare, education,
        and enterprise environments.
      </p>
      <p>
        What makes me unique is my ability to blend technical detail with strategic direction.
        Whether building software, managing telecom systems, or guiding teams through complex
        transitions, I deliver practical and sustainable results.
      </p>
      <p>
        Through my consulting and technical leadership work, I continue to help organizations
        transform operations and build resilient technology foundations.
      </p>
    </section>

    <section id="skills" class="content-block">
      <h2>Skills</h2>
      <div class="skills-grid">
        <div>
          <h3>Programming Skills</h3>
          <ul class="skills-list">
            {skillsLeft.map((skill) => (
              <li>
                <div class="skill-row">
                  <span>{skill.name}</span>
                  <span>{skill.level}%</span>
                </div>
                <div class="bar"><span style={`width: ${skill.level}%`}></span></div>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Other Skills</h3>
          <ul class="skills-list">
            {skillsRight.map((skill) => (
              <li>
                <div class="skill-row">
                  <span>{skill.name}</span>
                  <span>{skill.level}%</span>
                </div>
                <div class="bar"><span style={`width: ${skill.level}%`}></span></div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="badges" class="content-block">
      <h2>Badges</h2>
      <div class="media-carousel" data-carousel>
        <button type="button" class="carousel-arrow" data-prev aria-label="Previous badge">‹</button>
        <ul class="carousel-track">
        {badges.map((badge) => (
          <li class="carousel-item" data-slide>
            <button
              type="button"
              class="media-link media-trigger"
              data-lightbox-type="image"
              data-lightbox-src={badge.src}
              data-lightbox-title={badge.alt}
              aria-label={`Open ${badge.alt} in lightbox`}
            >
              <img src={badge.src} alt={badge.alt} loading="lazy" class="media-image badge-image" />
            </button>
          </li>
        ))}
        </ul>
        <button type="button" class="carousel-arrow" data-next aria-label="Next badge">›</button>
      </div>
    </section>

    <section id="certifications" class="content-block">
      <h2>Certifications</h2>
      <div class="media-carousel" data-carousel>
        <button type="button" class="carousel-arrow" data-prev aria-label="Previous certification">‹</button>
        <ul class="carousel-track">
        {certifications.map((cert) => (
          <li class="carousel-item" data-slide>
            <button
              type="button"
              class="media-link media-trigger"
              data-lightbox-type="image"
              data-lightbox-src={cert.src}
              data-lightbox-title={cert.alt}
              aria-label={`Open ${cert.alt} in lightbox`}
            >
              <img src={cert.src} alt={cert.alt} loading="lazy" class="media-image cert-image" />
            </button>
          </li>
        ))}
        </ul>
        <button type="button" class="carousel-arrow" data-next aria-label="Next certification">›</button>
      </div>
    </section>

    <section id="transcripts" class="content-block">
      <h2>Transcripts</h2>
      <p class="transcript-links">
        {transcripts.map((item) => (
          <button
            type="button"
            class="transcript-pill media-trigger"
            data-lightbox-type="pdf"
            data-lightbox-src={item.href}
            data-lightbox-title={`${item.label} Transcript`}
            aria-label={`Open ${item.label} transcript in lightbox`}
          >
            {item.label}
            <svg viewBox="0 0 24 24" aria-hidden="true" class="external-link-icon">
              <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"></path>
              <path d="M5 5h6v2H7v10h10v-4h2v6H5V5z"></path>
            </svg>
          </button>
        ))}
      </p>
    </section>

    <section id="timeline" class="content-block">
      <h2>Timeline</h2>
      <ol class="timeline">
        {timeline.map((entry) => (
          <li>
            <h3>{entry.role}</h3>
            <p class="meta">{entry.company} • {entry.location}</p>
            <p class="meta">{entry.period}</p>
            <p>{entry.summary}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="lightbox" data-lightbox hidden>
      <div class="lightbox-backdrop" data-lightbox-close></div>
      <div class="lightbox-panel" role="dialog" aria-modal="true" aria-label="Media lightbox">
        <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">×</button>
        <h3 class="lightbox-title" data-lightbox-title></h3>
        <div class="lightbox-content" data-lightbox-content></div>
      </div>
    </div>
  </section>

  <script is:inline>
    const carousels = Array.from(document.querySelectorAll("[data-carousel]"));

    carousels.forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll("[data-slide]"));
      const prev = carousel.querySelector("[data-prev]");
      const next = carousel.querySelector("[data-next]");
      let active = 0;
      let timer;

      const sync = () => {
        slides.forEach((slide, idx) => {
          slide.hidden = idx !== active;
        });
      };

      const stop = () => {
        if (timer) {
          clearInterval(timer);
          timer = undefined;
        }
      };

      const start = () => {
        stop();
        timer = setInterval(() => {
          active = (active + 1) % slides.length;
          sync();
        }, 4500);
      };

      prev?.addEventListener("click", () => {
        active = (active - 1 + slides.length) % slides.length;
        sync();
      });

      next?.addEventListener("click", () => {
        active = (active + 1) % slides.length;
        sync();
      });

      carousel.addEventListener("mouseenter", stop);
      carousel.addEventListener("mouseleave", start);
      carousel.addEventListener("focusin", stop);
      carousel.addEventListener("focusout", () => {
        if (!carousel.contains(document.activeElement)) {
          start();
        }
      });

      sync();
      if (slides.length > 1) start();
    });

    const lightbox = document.querySelector("[data-lightbox]");
    const lightboxContent = lightbox?.querySelector("[data-lightbox-content]");
    const lightboxTitle = lightbox?.querySelector("[data-lightbox-title]");

    const closeLightbox = () => {
      if (!lightbox || !lightboxContent) return;
      lightbox.hidden = true;
      lightboxContent.innerHTML = "";
    };

    document.querySelectorAll("[data-lightbox-close]").forEach((node) => {
      node.addEventListener("click", closeLightbox);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeLightbox();
    });

    document.querySelectorAll(".media-trigger").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        if (!lightbox || !lightboxContent || !lightboxTitle) return;

        const type = trigger.getAttribute("data-lightbox-type");
        const src = trigger.getAttribute("data-lightbox-src");
        const title = trigger.getAttribute("data-lightbox-title") || "Preview";
        if (!src) return;

        lightboxTitle.textContent = title;
        lightboxContent.innerHTML = "";

        if (type === "pdf") {
          const frame = document.createElement("iframe");
          frame.src = src;
          frame.title = title;
          frame.className = "lightbox-frame";
          frame.loading = "lazy";
          lightboxContent.appendChild(frame);
        } else {
          const image = document.createElement("img");
          image.src = src;
          image.alt = title;
          image.className = "lightbox-image";
          image.loading = "lazy";
          lightboxContent.appendChild(image);
        }

        lightbox.hidden = false;
      });
    });
  </script>
</Layout>

<style>
  .page {
    padding: var(--space-16) 0;
    display: grid;
    gap: var(--space-8);
  }

  .about-hero {
    display: grid;
    gap: var(--space-4);
  }

  .hero-subtitle {

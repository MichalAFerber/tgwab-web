---
interface Props {
  site: "ferber" | "tgwab" | "dev" | "kj4dia" | "ferberme";
}

const { site } = Astro.props;

const localLinks = [
  { href: "/about/", label: "About", kind: "about" },
  { href: "/contact/", label: "Contact", kind: "contact" },
  { href: "/privacy-policy/", label: "Privacy", kind: "privacy" },
  { href: "/terms-of-use/", label: "Terms", kind: "terms" },
];

const domainLinks = [
  { href: "https://ferber.me/", label: "Ferber.me", tooltip: "Family" },
  { href: "https://kj4dia.me/", label: "KJ4dia.me", tooltip: "Amateur Radio" },
  { href: "https://michalferber.me/", label: "michalferber.me", tooltip: "Blog" },
  { href: "https://michalferber.dev/", label: "michalferber.dev", tooltip: "Products" },
  { href: "https://techguywithabeard.com/", label: "techguywithabeard.com", tooltip: "Services" },
];

const bmcLink = {
  href: "https://www.buymeacoffee.com/TechGuyWithABeard",
  label: "Buy Me A Coffee",
  external: true,
};

const year = new Date().getFullYear(); // rendered at build time per dev-standards §1
---

<footer class="tgwab-footer">
  <div class="container tgwab-footer__inner">
    <div class="tgwab-footer__brand">
      <nav class="tgwab-footer__actions" aria-label="Profile links">
        <a
          href={bmcLink.href}
          target={bmcLink.external ? "_blank" : undefined}
          rel={bmcLink.external ? "noopener noreferrer" : undefined}
          class="bmc-link"
        >
          <img
            src="/assets/bmc-button.png"
            alt="Buy Me A Coffee"
            class="action-image"
            width="217"
            height="60"
          />
        </a>

        <a
          href="/contact/"
          class="bmc-link"
          data-cal-link="techguywithabeard/meet"
          data-cal-namespace="meet"
        >
          <svg class="action-image" viewBox="0 0 217 60" role="img" aria-label="Book call button">
            <defs>
              <linearGradient id="bookcall-bg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#161616"></stop>
                <stop offset="100%" stop-color="#0d0d0d"></stop>
              </linearGradient>
            </defs>
            <rect x="0.5" y="0.5" width="216" height="59" rx="10" fill="url(#bookcall-bg)" stroke="#303030"></rect>
            <rect x="10" y="10" width="40" height="40" rx="9" fill="#f4f4f4"></rect>
            <rect x="20" y="20" width="20" height="17" rx="3" fill="#111111"></rect>
            <rect x="20" y="17" width="20" height="5" rx="2" fill="#111111"></rect>
            <rect x="24" y="14" width="2" height="6" rx="1" fill="#f4f4f4"></rect>
            <rect x="34" y="14" width="2" height="6" rx="1" fill="#f4f4f4"></rect>
            <rect x="24" y="27" width="4" height="3" rx="1" fill="#f4f4f4"></rect>
            <rect x="30" y="27" width="4" height="3" rx="1" fill="#f4f4f4"></rect>
            <rect x="24" y="32" width="4" height="3" rx="1" fill="#f4f4f4"></rect>
            <rect x="30" y="32" width="4" height="3" rx="1" fill="#f4f4f4"></rect>
            <text x="59" y="29" fill="#fafafa" font-family="Avenir Next, Montserrat, Segoe UI, sans-serif" font-size="15" font-weight="700" letter-spacing="0.25">Book a Call</text>
            <text x="59" y="42" fill="#a3a3a3" font-family="Avenir Next, Montserrat, Segoe UI, sans-serif" font-size="9.5" letter-spacing="0.2">Schedule with Cal.com</text>
          </svg>
        </a>
      </nav>
    </div>
    <div class="tgwab-footer__right">
      <nav class="tgwab-footer__local-links" aria-label="Footer links">
        {localLinks.map((link) => (
          <a href={link.href} class="domain-pill">
            {link.kind === "about" && (
              <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2zm0 4a1.6 1.6 0 1 1-1.6 1.6A1.6 1.6 0 0 1 12 6zm2 12h-4v-1.5h1V11h-1V9.5h3V16h1z" />
              </svg>
            )}
            {link.kind === "contact" && (
              <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-.4 2L12 11.4 4.4 6h15.2zM4 18V8.2l7.42 5.26a1 1 0 0 0 1.16 0L20 8.2V18H4z" />
              </svg>
            )}
            {link.kind === "privacy" && (
              <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2 4 5v6c0 5.1 3.4 9.9 8 11 4.6-1.1 8-5.9 8-11V5l-8-3zm0 2.1 6 2.25V11c0 4.2-2.7 8.1-6 9-3.3-.9-6-4.8-6-9V6.35L12 4.1z" />
              </svg>
            )}
            {link.kind === "terms" && (
              <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm8 1.5V8h4.5L14 3.5zM8 12h8v1.5H8V12zm0 3h8v1.5H8V15zm0 3h6v1.5H8V18z" />
              </svg>
            )}
            {link.label}
          </a>
        ))}
      </nav>
      <nav class="tgwab-footer__domains" aria-label="Footer domains">
        {domainLinks.map((link) => (
          <a
            href={link.href}
            class="domain-pill"
            title={link.tooltip}
            data-tooltip={link.tooltip}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
  <div class="container tgwab-footer__bottom">
    <nav class="tgwab-footer__icons" aria-label="Social links">
      <a
        href="https://github.com/MichalAFerber"
        target="_blank"
        rel="noopener noreferrer"
        class="social-chip social-chip--github"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <a
        href="https://x.com/MichalAFerber"
        target="_blank"
        rel="noopener noreferrer"
        class="social-chip social-chip--x"
        aria-label="X"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.24 2H21l-6.02 6.9L22 22h-5.48l-4.3-6.59L6.48 22H3.7l6.44-7.36L2 2h5.62l3.89 5.95L18.24 2zm-.97 18h1.52L6.8 3.9H5.18L17.27 20z" />
        </svg>
      </a>
    </nav>
    <p class="tgwab-footer__copyright">
      © {year} | Created with ❤️ by{' '}
      <a href="https://michalferber.dev/" target="_blank" rel="noopener">Michal Ferber</a>, aka{' '}
      <a href="https://techguywithabeard.com/" target="_blank" rel="noopener">TechGuyWithABeard</a>.
    </p>
  </div>
</footer>

<style>
  .tgwab-footer {
    margin-top: var(--space-20);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .tgwab-footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .tgwab-footer__brand {
    display: grid;
    gap: var(--space-3);
  }

  .tgwab-footer__actions {
    display: grid;
    gap: var(--space-3);
  }

  /* Mobile-first (DEV-STANDARDS §3): base = stacked rows, left-aligned;
     ≥980px = right-hand columns; ≥1400px = roomier column gap. */
  .tgwab-footer__right {
    width: 100%;
    display: grid;
    grid-auto-flow: row;
    gap: var(--space-8);
    align-items: flex-start;
  }

  .tgwab-footer__local-links {
    display: grid;
    gap: var(--space-2);
    align-items: flex-start;
    justify-items: start;
  }

  .tgwab-footer__domains {
    display: grid;
    gap: var(--space-2);
    align-items: flex-start;
    justify-items: start;
  }

  @media (min-width: 980px) {
    .tgwab-footer__right {
      width: auto;
      margin-left: auto;
      grid-auto-flow: column;
      grid-auto-columns: max-content;
    }

    .tgwab-footer__local-links,
    .tgwab-footer__domains {
      align-items: flex-end;
      justify-items: end;
    }
  }

  @media (min-width: 1400px) {
    .tgwab-footer__right {
      gap: calc(var(--space-12) + var(--space-2));
    }
  }

  .domain-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 0.73rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.32rem 0.62rem;
    transition: transform 180ms ease, color 180ms ease;
  }

  .domain-pill:hover {
    color: var(--ink);
    transform: translateY(-1px);
  }

  .tgwab-footer__actions .domain-pill,
  .tgwab-footer__local-links .domain-pill {
    text-transform: none;
    letter-spacing: normal;
    font-size: var(--step--1);
  }

  .domain-pill[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.35rem);
    transform: translateX(-50%);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    color: var(--ink);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.16rem 0.38rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 130ms ease;
  }

  .domain-pill[data-tooltip]:hover::after {
    opacity: 1;
  }

  .social-icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    flex-shrink: 0;
  }

  .bmc-link {
    display: inline-flex;
    align-items: center;
  }

  .action-image {
    width: 217px;
    height: 60px;
    display: block;
  }

  /* Touch targets ≥40px (DEV-STANDARDS §3/§14). */
  @media (pointer: coarse) {
    .domain-pill {
      min-height: 40px;
    }
  }

  /* Centered bottom strip: brand icon chips above the standard © line. */
  .tgwab-footer__bottom {
    margin-top: var(--space-8);
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .tgwab-footer__icons {
    display: flex;
    gap: var(--space-4);
  }

  /* GitHub #181717 and X #000 are the official brand colors; the border keeps
     the chips legible on the dark themes. Chip size covers §3/§14 touch targets. */
  .social-chip {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 180ms ease;
  }

  .social-chip:hover {
    transform: translateY(-2px);
  }

  .social-chip--github {
    background: #181717;
  }

  .social-chip--x {
    background: #000000;
  }

  .social-chip svg {
    width: 22px;
    height: 22px;
    fill: #ffffff;
  }

  .tgwab-footer__copyright {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .tgwab-footer__copyright a {
    color: var(--accent);
    text-decoration: none;
  }

  .tgwab-footer__copyright a:hover {
    text-decoration: underline;
  }
</style>
